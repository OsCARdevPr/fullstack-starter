{
  "name": "fullstack-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:integration": "pnpm --filter @starter/api test:integration",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "gen:module": "node scripts/gen-module/cli.mjs",
    "setup:project": "node scripts/setup-project/cli.mjs",
    "db:generate": "pnpm --filter @starter/api db:generate",
    "db:migrate": "pnpm --filter @starter/api db:migrate",
    "db:seed": "pnpm --filter @starter/api db:seed",
    "db:up": "docker compose -f docker/compose.dev.yaml up -d",
    "db:down": "docker compose -f docker/compose.dev.yaml down",
    "docker:up": "docker compose -f docker/compose.yaml up --build -d",
    "docker:seed": "docker compose -f docker/compose.yaml --profile seed run --rm seed",
    "docker:down": "docker compose -f docker/compose.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
