# Copy to `.env` and adjust. Values below are local development placeholders only.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app
# Integration tests only (pnpm test:integration). Name must end in _test; it is created automatically.
DATABASE_URL_TEST=postgres://app:app@localhost:5432/app_test

# --- Auth (Better Auth) ---
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
# The API refuses to start in production with this placeholder.
BETTER_AUTH_SECRET=dev-only-insecure-secret-replace-me-0123456789
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# false = invite-only (typical for admin apps)
AUTH_ALLOW_SIGNUP=true

# --- Tenancy ---
# single: one default organization, users join it automatically, org switcher hidden
# multi:  users create and switch between organizations
TENANCY_MODE=single
DEFAULT_ORG_NAME=Default Organization
DEFAULT_ORG_SLUG=default

# --- Seed (initial platform admin) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-123
SEED_ADMIN_NAME=Admin

# --- HTTP hardening ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BODY_LIMIT_BYTES=1048576
# true only behind exactly one trusted reverse proxy (e.g. the nginx container)
TRUST_PROXY=false

# --- Web (exposed to the browser: never put secrets in VITE_* vars) ---
VITE_APP_NAME=Fullstack Starter
