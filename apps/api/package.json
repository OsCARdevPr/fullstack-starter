{
  "name": "@starter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API. The package export is type-only: it exposes AppType for the web RPC client.",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "auth:generate": "auth generate --config src/lib/auth.cli.ts --output src/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "@starter/contracts": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
